#!/usr/bin/env bash
# vs-kaggle-probe [ACCELERATOR] — push a tiny private GPU kernel to Kaggle, wait, download probe.json.
#   ACCELERATOR: NvidiaTeslaT4 (default, T4 x2) | NvidiaL4      Uses ~2 minutes of your weekly GPU quota.
# Needs: pip package `kaggle`, KAGGLE_API_TOKEN (a network secret for api.kaggle.com works:
# the CLI sends it as a Bearer header) and KAGGLE_USERNAME. Kaggle requires a phone-verified account
# for GPU and internet in kernels.
set -euo pipefail
ACC="${1:-NvidiaTeslaT4}"; U="${KAGGLE_USERNAME:?set KAGGLE_USERNAME}"
HERE="$(cd "$(dirname "$0")/.." && pwd)"; W="$(mktemp -d)"; trap 'rm -rf "$W"' EXIT
SLUG="vs-gpu-probe"; cp "$HERE/cloud/kaggle-probe/probe.py" "$W/"
cat > "$W/kernel-metadata.json" <<J
{"id": "$U/$SLUG", "title": "$SLUG", "code_file": "probe.py", "language": "python", "kernel_type": "script",
 "is_private": "true", "enable_gpu": "true", "enable_internet": "true", "machine_shape": "$ACC",
 "dataset_sources": [], "competition_sources": [], "kernel_sources": [], "model_sources": []}
J
t0=$(date +%s)
kaggle kernels push -p "$W" --accelerator "$ACC" --timeout 900
while :; do
  st="$(kaggle kernels status "$U/$SLUG" 2>&1 | tail -1)"; echo "  $(( $(date +%s)-t0 ))s  $st"
  case "$st" in *COMPLETE*|*complete*) break ;; *ERROR*|*error*|*CANCEL*) echo "kernel failed"; exit 1 ;; esac
  sleep 20
done
mkdir -p "$HERE/samples-out"; kaggle kernels output "$U/$SLUG" -p "$W/out" -o -q
cp "$W/out/probe.json" "$HERE/samples-out/kaggle-probe-$ACC.json"; cat "$W/out/probe.json"
echo "round trip (queue + boot + run + download): $(( $(date +%s)-t0 ))s"
