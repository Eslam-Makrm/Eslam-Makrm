#!/usr/bin/env bash
# vs-doctor — prove the studio is installed AND runnable on THIS machine (read-only).
#
#   vs-doctor              inventory: Codex, skills, tools, models, fonts, hardware tier
#   vs-doctor --smoke      also run ~1-minute functional tests (encode, Arabic subtitles, Piper, Whisper, Manim)
#   vs-doctor --codex      ask the Codex CLI itself (codex exec) to run the smoke test inside its own
#                          sandbox and to list the skills it can see — the proof that matters
#   vs-doctor --json       machine-readable summary on the last line
#
# Nothing is installed, downloaded or changed. Smoke outputs go to a temp dir that is deleted.
# Exit code: 0 = no FAIL, 1 = at least one FAIL.
set -uo pipefail
SMOKE=0; ASK_CODEX=0; JSON=0
for a in "$@"; do case "$a" in
  --smoke) SMOKE=1 ;; --codex) ASK_CODEX=1 ;; --json) JSON=1 ;;
  -h|--help) sed -n 2,11p "$0"; exit 0 ;; *) echo "unknown option $a" >&2; exit 2 ;; esac; done

export VS_HOME="${VS_HOME:-$HOME/.video-studio}"
export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
[ -f "$VS_HOME/env.sh" ] && source "$VS_HOME/env.sh"
P=0; W=0; F=0; FAILS=()
pass() { printf '  PASS  %s\n' "$*"; P=$((P+1)); }
warn() { printf '  WARN  %s\n' "$*"; W=$((W+1)); }
fail() { printf '  FAIL  %s\n' "$*"; F=$((F+1)); FAILS+=("$*"); }
hdr()  { printf '\n== %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# ------------------------------------------------------------------ 1. Codex itself
hdr "Codex"
if have codex; then pass "codex CLI $(codex --version 2>/dev/null | head -1)"; else
  warn "codex CLI not on PATH (fine for the Codex IDE extension / desktop app; --codex needs the CLI)"; fi
pass "CODEX_HOME=$CODEX_HOME"
[ -d "$CODEX_HOME/skills/.system/skill-installer" ] && pass "\$skill-installer unpacked" \
  || warn "\$skill-installer not unpacked yet (run \`codex\` once)"
[ -d "$CODEX_HOME/skills/.system/imagegen" ] && pass "built-in imagegen skill present (online, uses your ChatGPT plan)" \
  || warn "built-in imagegen skill not found (older Codex, or not unpacked yet)"

# ------------------------------------------------------------------ 2. skills where Codex scans them
hdr "Skills (Codex scans \$CODEX_HOME/skills, ~/.agents/skills, <repo>/.agents/skills, /etc/codex/skills)"
EXPECTED="video-studio arabic-voiceover arabic-motion-graphics animated-stories auto-subtitles video-editing
hyperframes hyperframes-cli hyperframes-registry media-use reverse-any-video style-sampling
manim-composer manimce-best-practices explainroo"
# Phase-2 skills (only checked when present): reported, never failed.
OPTIONAL="video-producer storyboard cinematic-camera video-qc lip-sync ai-image ai-video character-bible"
check_skill() {  # dir name -> 0 ok / 1 bad (prints)
  local d="$1" n="$2" f="$1/SKILL.md"
  [ -f "$f" ] || { echo "no SKILL.md"; return 1; }
  python3 - "$f" "$n" <<'PY'
import sys,re
t=open(sys.argv[1],encoding="utf-8").read()
m=re.match(r"^---\n(.*?)\n---\n",t,re.S)
if not m: print("no YAML frontmatter"); sys.exit(1)
fm=dict(re.findall(r"^(\w[\w-]*):\s*(.*)$",m.group(1),re.M))
if fm.get("name","").strip().strip('"')!=sys.argv[2]: print("frontmatter name != folder"); sys.exit(1)
if not fm.get("description","").strip(): print("empty description"); sys.exit(1)
PY
}
find_skill() {  # name -> first dir found
  local top; top="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
  for root in "$CODEX_HOME/skills" "$HOME/.agents/skills" "$PWD/.agents/skills" "$top/.agents/skills" /etc/codex/skills; do
    [ -d "$root/$1" ] && { echo "$root/$1"; return; }; done; }
for n in $EXPECTED; do
  d="$(find_skill "$n")"
  if [ -z "$d" ]; then fail "skill $n not installed"; continue; fi
  if msg="$(check_skill "$d" "$n")"; then pass "skill $n  ($d)"; else fail "skill $n: $msg"; fi
done
for n in $OPTIONAL; do
  d="$(find_skill "$n")"; [ -z "$d" ] && continue
  if msg="$(check_skill "$d" "$n")"; then pass "skill $n (phase 2)"; else fail "skill $n: $msg"; fi
done
grep -rqs "codex-video-studio patched" "$CODEX_HOME/skills/hyperframes" 2>/dev/null \
  && pass "upstream skills patched (free-only, telemetry off)" || warn "upstream skills not patched (run patch-upstream.py)"

# ------------------------------------------------------------------ 3. tools
hdr "Tools ($VS_HOME)"
[ -f "$VS_HOME/env.sh" ] && pass "env.sh" || fail "env.sh missing — run install.sh"
if have ffmpeg; then
  pass "ffmpeg $(ffmpeg -version | head -1 | cut -d' ' -f3)"
  bc="$(ffmpeg -hide_banner -buildconf 2>/dev/null)"
  for lib in libass libfribidi libharfbuzz libx264; do
    grep -q -- "--enable-$lib" <<<"$bc" && pass "ffmpeg $lib" || { [ $lib = libharfbuzz ] && warn "ffmpeg without $lib (Arabic shaping relies on libass+harfbuzz)" || fail "ffmpeg without $lib"; }
  done
else fail "ffmpeg missing"; fi
if have node; then v="$(node -p 'process.versions.node.split(".")[0]')"
  [ "$v" -ge 20 ] && pass "node $(node -v)" || fail "node $(node -v) < 20"; else fail "node missing"; fi
CH="$(command -v google-chrome || command -v chromium || command -v chromium-browser || true)"
[ -z "$CH" ] && [ -d "/Applications/Google Chrome.app" ] && CH="/Applications/Google Chrome.app"
[ -n "$CH" ] && pass "chrome $CH" || fail "Chrome/Chromium missing (HyperFrames, explainroo, animated-stories)"
have latex && pass "latex" || warn "LaTeX missing (Manim MathTex)"
pyok() { "$1" -c "$2" >/dev/null 2>&1; }
VP="$VS_HOME/venv/bin/python"
if [ -x "$VP" ]; then
  pyok "$VP" "import faster_whisper" && pass "venv: faster-whisper" || fail "venv: faster-whisper import fails"
  pyok "$VP" "import piper" && pass "venv: piper-tts" || fail "venv: piper-tts import fails"
  pyok "$VP" "import edge_tts" && pass "venv: edge-tts (online)" || warn "venv: edge-tts missing"
else fail "venv missing ($VP)"; fi
[ -x "$VS_HOME/venv-manim/bin/manim" ] && pyok "$VS_HOME/venv-manim/bin/python" "import manim" && pass "venv-manim: manim" || fail "manim venv missing/broken"
[ -x "$VS_HOME/venv-editor/bin/auto-editor" ] && pass "venv-editor: auto-editor" || warn "auto-editor missing"
[ -s "$VS_HOME/vendor/gsap.min.js" ] && pass "gsap (local copy)" || fail "vendor/gsap.min.js missing"
[ -f "$CODEX_HOME/skills/hyperframes/scripts/plugin-cli.mjs" ] && pass "HyperFrames CLI (pinned by skill)" || fail "HyperFrames CLI missing"

hdr "Models and fonts"
for m in ar_JO-kareem-medium en_US-lessac-medium; do
  [ -s "$VS_HOME/models/piper/$m.onnx" ] && pass "Piper $m" || fail "Piper $m missing"; done
for m in small large-v3-turbo; do
  ls -d "$VS_HOME"/models/hf/hub/models--*faster-whisper-$m* >/dev/null 2>&1 \
    || ls -d "$VS_HOME"/models/hf/hub/models--*whisper-$m* >/dev/null 2>&1 \
    && pass "Whisper $m" || warn "Whisper $m not cached"; done
if have fc-list; then
  for fnt in "Amiri" "Cairo" "Noto Naskh Arabic"; do
    fc-list | grep -qi "$fnt" && pass "font $fnt" || { [ "$fnt" = "Noto Naskh Arabic" ] && warn "font $fnt missing (Amiri is the fallback)" || fail "font $fnt missing"; }; done
else warn "fc-list missing; fonts not checked"; fi

# ------------------------------------------------------------------ 4. hardware → which tier can run here
hdr "Hardware"
OS="$(uname -s)"; ARCH="$(uname -m)"
CORES="$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo ?)"
if [ "$OS" = Darwin ]; then RAM_GB=$(( $(sysctl -n hw.memsize) / 1073741824 ));
else RAM_GB=$(awk '/MemTotal/{printf "%d",$2/1048576}' /proc/meminfo 2>/dev/null || echo 0); fi
mkdir -p "$VS_HOME" 2>/dev/null
DISK_GB=$(df -Pk "$VS_HOME" 2>/dev/null | awk 'NR==2{printf "%d",$4/1048576}')
pass "$OS $ARCH, $CORES cores, ${RAM_GB} GB RAM, ${DISK_GB} GB free at $VS_HOME"
grep -qi microsoft /proc/version 2>/dev/null && pass "WSL2 detected (CUDA works through the Windows NVIDIA driver)"
GPU="none"; VRAM=0
if have nvidia-smi && nvidia-smi -L >/dev/null 2>&1; then
  line="$(nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader,nounits | head -1)"
  GPU="$(cut -d, -f1 <<<"$line" | xargs)"; VRAM=$(( $(cut -d, -f2 <<<"$line" | xargs) / 1024 ))
  pass "NVIDIA $GPU, ${VRAM} GB VRAM, driver $(cut -d, -f3 <<<"$line" | xargs)"
elif [ "$OS" = Darwin ] && [ "$ARCH" = arm64 ]; then
  GPU="apple-silicon"; VRAM=$RAM_GB
  pass "Apple Silicon (Metal/MPS, unified memory ${RAM_GB} GB) — GPU models run, 3-10x slower than CUDA"
else warn "no usable GPU found: AI video/image/lip-sync models need a free cloud GPU (Colab/Kaggle) or stay unavailable"; fi
TIER="cpu"
if [ "$GPU" != none ]; then
  if [ "$VRAM" -ge 24 ]; then TIER="gpu-24"; elif [ "$VRAM" -ge 16 ]; then TIER="gpu-16";
  elif [ "$VRAM" -ge 8 ]; then TIER="gpu-8"; else TIER="cpu"; warn "GPU under 8 GB: treated as CPU tier"; fi
fi
case "$TIER" in
  cpu)    echo "  tier: CPU — everything in phase 1 runs; AI video/image models only via free cloud GPU notebooks" ;;
  gpu-8)  echo "  tier: GPU-8 — Wan2.2-5B (GGUF, ≤480p), Z-Image-Turbo (fp8/GGUF), MuseTalk, Chatterbox" ;;
  gpu-16) echo "  tier: GPU-16 — + Wan2.2-5B 720p, FLUX.2-klein-4B, LatentSync 1.5" ;;
  gpu-24) echo "  tier: GPU-24+ — + Wan2.2-A14B (fp8), character LoRA training, Wan2.2-Animate" ;;
esac
[ "${DISK_GB:-0}" -lt 20 ] && warn "under 20 GB free: phase-2 models need 40-90 GB"

# ------------------------------------------------------------------ 5. smoke tests (real work, temp dir)
if [ "$SMOKE" = 1 ]; then
  hdr "Smoke tests (≈1 min)"
  T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
  ffmpeg -v error -f lavfi -i testsrc2=s=640x360:d=2 -f lavfi -i sine=d=2 -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest "$T/a.mp4" \
    && pass "ffmpeg encode H.264/AAC" || fail "ffmpeg encode"
  printf '1\n00:00:00,000 --> 00:00:02,000\nلا إله إلا الله — أهلاً بكم\n' > "$T/a.srt"
  FONT=Amiri; fc-list 2>/dev/null | grep -qi "Noto Naskh Arabic" && FONT="Noto Naskh Arabic"
  ffmpeg -v error -i "$T/a.mp4" -vf "subtitles=$T/a.srt:force_style='FontName=$FONT'" -c:a copy "$T/s.mp4" \
    && pass "Arabic subtitle burn runs (libass, $FONT; shaping is judged by eye in the real tests)" || fail "Arabic subtitle burn"
  if [ -x "$VP" ] && [ -s "$VS_HOME/models/piper/ar_JO-kareem-medium.onnx" ]; then
    t0=$(date +%s)
    echo "مَرْحَبًا بِكُمْ فِي الِاسْتُودْيُو." | "$VP" -m piper -m "$VS_HOME/models/piper/ar_JO-kareem-medium.onnx" -f "$T/v.wav" >/dev/null 2>&1 \
      && [ -s "$T/v.wav" ] && pass "Piper Arabic TTS ($(( $(date +%s)-t0 )) s)" || fail "Piper Arabic TTS"
    if [ -s "$T/v.wav" ]; then
      out="$(HF_HUB_OFFLINE=1 "$VP" - "$T/v.wav" <<'PY' 2>/dev/null
import sys
from faster_whisper import WhisperModel
m=WhisperModel("small",device="cpu",compute_type="int8")
segs,_=m.transcribe(sys.argv[1],language="ar")
print("".join(s.text for s in segs).strip())
PY
)"
      [ -n "$out" ] && pass "Whisper round-trip: «$out»" || fail "Whisper transcription (offline, model 'small')"
    fi
  else fail "Piper smoke test skipped: venv or voice missing"; fi
  if [ -x "$VS_HOME/venv-manim/bin/manim" ]; then
    cat > "$T/m.py" <<'PY'
from manim import *
class S(Scene):
    def construct(self): self.play(Create(Circle()), run_time=0.5)
PY
    (cd "$T" && "$VS_HOME/venv-manim/bin/manim" -ql --disable_caching -o m.mp4 m.py S >/dev/null 2>&1) \
      && [ -n "$(find "$T" -name m.mp4)" ] && pass "Manim render" || fail "Manim render"
  fi
  if [ -f "$CODEX_HOME/skills/hyperframes/scripts/plugin-cli.mjs" ]; then
    node "$CODEX_HOME/skills/hyperframes/scripts/plugin-cli.mjs" --version >/dev/null 2>&1 \
      && pass "HyperFrames CLI starts" || fail "HyperFrames CLI does not start"
  fi
fi

# ------------------------------------------------------------------ 6. ask Codex itself
if [ "$ASK_CODEX" = 1 ]; then
  hdr "Codex self-check (codex exec, uses your Codex plan for one short task)"
  if have codex; then
    codex exec --skip-git-repo-check \
      "Run this shell command and print its full output verbatim: bash \"$0\" --smoke . Then, on a new line starting with SKILLS:, list the names of every skill available to you in this session, comma-separated. Do not install or change anything." \
      || fail "codex exec failed (signed in? run \`codex login\`)"
  else fail "codex CLI not found; inside the Codex app type: run vs-doctor --smoke and list your skills"; fi
fi

hdr "Summary"
echo "  PASS=$P WARN=$W FAIL=$F  tier=$TIER"
for x in "${FAILS[@]+"${FAILS[@]}"}"; do echo "  - $x"; done
[ "$JSON" = 1 ] && printf '{"pass":%d,"warn":%d,"fail":%d,"tier":"%s","gpu":"%s","vram_gb":%d,"ram_gb":%d,"disk_gb":%d,"os":"%s"}\n' \
  "$P" "$W" "$F" "$TIER" "$GPU" "$VRAM" "${RAM_GB:-0}" "${DISK_GB:-0}" "$OS"
[ "$F" = 0 ]
